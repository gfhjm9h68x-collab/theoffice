# watchd — fleet trigger service (systemd --user unit).
# Install: cp to ~/.config/systemd/user/watchd.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now watchd.service
# Rollback: systemctl --user disable --now watchd.service  (zero engine side effects).
[Unit]
Description=watchd — fleet trigger service (wakes agents on registered conditions; kills the foreground poll-loop anti-pattern, FLEET RULE 1)
After=network-online.target

[Service]
Type=simple
# This box's tenant root; adjust if the checkout moves.
Environment=OFFICE_TENANT_ROOT=/opt/claude/theoffice/tenant
ExecStart=/usr/bin/python3 /opt/claude/theoffice/tools/watchd/watchd.py
Restart=always
RestartSec=5
# Lightweight single stdlib-python process (footprint was the whole point).
MemoryHigh=64M
MemoryMax=128M

[Install]
WantedBy=default.target
